{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Démarrer le backend et le frontend",
            "detail": "Lance Django et React",
            "group": "build",
            "dependsOn": [
                "Démarrer le backend",
                "Démarrer le frontend"
            ],
            "problemMatcher": []
        },
        {
            "label": "Démarrer le backend",
            "detail": "Active le venv et lance Django runserver",
            "type": "shell",
            "command": ".\\venv\\Scripts\\activate; python manage.py runserver",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": "build",
            "presentation": {
                "group": "servers",
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Démarrer le frontend",
            "detail": "Lance le serveur React",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": "build",
            "presentation": {
                "group": "servers",
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Preparer publication Docker",
            "detail": "Genere le dossier publish sans deployer",
            "type": "shell",
            "command": "bash publish-prepare.sh",
            "options": {
                "cwd": "${workspaceFolder}/docker"
            },
            "group": "build",
            "presentation": {
                "group": "deploy",
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Publier Docker Infolab",
            "detail": "Prepare, envoie et relance Docker sur Infolab",
            "type": "shell",
            "command": "bash publish-docker-infolab.sh",
            "options": {
                "cwd": "${workspaceFolder}/docker"
            },
            "group": "build",
            "presentation": {
                "group": "deploy",
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Demarrer scheduler prod",
            "detail": "Relance uniquement le scheduler Docker sur Infolab",
            "type": "shell",
            "command": "bash scheduler-start-infolab.sh",
            "options": {
                "cwd": "${workspaceFolder}/docker"
            },
            "group": "build",
            "presentation": {
                "group": "deploy",
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Arreter scheduler prod",
            "detail": "Stoppe uniquement le scheduler Docker sur Infolab",
            "type": "shell",
            "command": "bash scheduler-stop-infolab.sh",
            "options": {
                "cwd": "${workspaceFolder}/docker"
            },
            "group": "build",
            "presentation": {
                "group": "deploy",
                "reveal": "always"
            },
            "problemMatcher": []
        }
    ]
}
